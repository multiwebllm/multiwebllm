# Database
DATABASE_URL=postgres://multiwebllm:your_db_password@multiwebllm-db:5432/multiwebllm
DB_PASSWORD=your_db_password

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-secure-password

# JWT Secret (for admin session)
JWT_SECRET=change-this-to-a-random-string

# App
NEXT_PUBLIC_APP_NAME=MultiWebLLM

# Redis (for rate limiting & caching)
REDIS_URL=redis://multiwebllm-redis:6379

# GitHub Webhook Secret (for auto-upgrade)
WEBHOOK_SECRET=your-webhook-secret-here

# 定时巡检（/api/cron/provider-health），请使用随机长字符串
CRON_SECRET=change-this-to-a-random-cron-secret

# Telegram 通知在管理后台「系统设置」中配置（Bot Token / Chat ID）
