# Copy to aiproxy/.env (docker compose reads aiproxy/.env)
# cp aiproxy/.env.example aiproxy/.env

DATABASE_URL=postgres://multiwebllm:your_db_password@multiwebllm-db:5432/multiwebllm
DB_PASSWORD=your_db_password

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-secure-password

JWT_SECRET=change-this-to-a-random-string

NEXT_PUBLIC_APP_NAME=MultiWebLLM

REDIS_URL=redis://multiwebllm-redis:6379

WEBHOOK_SECRET=your-webhook-secret-here
